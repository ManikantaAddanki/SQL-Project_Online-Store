DELIMITER //


/* ------------------------------------------------------------
   1. Procedure to insert a new customer
   ------------------------------------------------------------ */

CREATE PROCEDURE add_customer(
    IN p_customer_id INT,
    IN p_name VARCHAR(100),
    IN p_email VARCHAR(100),
    IN p_phone VARCHAR(15),
    IN p_city VARCHAR(255),
    IN p_registration_date DATE
)
BEGIN
    INSERT INTO Customers
    (
        customer_id,
        name,
        email,
        phone,
        city,
        registration_date
    )
    VALUES
    (
        p_customer_id,
        p_name,
        p_email,
        p_phone,
        p_city,
        p_registration_date
    );
END //


/* ------------------------------------------------------------
   2. Procedure to update product price
   ------------------------------------------------------------ */

CREATE PROCEDURE update_product_price(
    IN p_product_id INT,
    IN p_new_price DECIMAL(10,2)
)
BEGIN
    UPDATE Products
    SET price = p_new_price
    WHERE product_id = p_product_id;
END //


/* ------------------------------------------------------------
   3. Procedure to display all orders of a customer
   ------------------------------------------------------------ */

CREATE PROCEDURE customer_orders_list(
    IN p_customer_id INT
)
BEGIN
    SELECT
        order_id,
        order_date,
        total_amount,
        status
    FROM Orders
    WHERE customer_id = p_customer_id;
END //


/* ------------------------------------------------------------
   4. Procedure to calculate total sales
   ------------------------------------------------------------ */

CREATE PROCEDURE total_sales()
BEGIN
    SELECT
        SUM(total_amount) AS total_sales
    FROM Orders
    WHERE status = 'Completed';
END //


/* ------------------------------------------------------------
   5. Procedure to list products in a category
   ------------------------------------------------------------ */

CREATE PROCEDURE products_by_category(
    IN p_category_id INT
)
BEGIN
    SELECT
        product_id,
        product_name,
        price,
        stock_quantity,
        added_date
    FROM Products
    WHERE category_id = p_category_id;
END //


/* End of procedures */

DELIMITER ;


