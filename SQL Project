   ============================================================ */


/*
   Delete cancelled order items first because of foreign key.
*/

DELETE FROM Order_Items
WHERE order_id IN (
    SELECT order_id
    FROM (
        SELECT order_id
        FROM Orders
        WHERE status = 'Cancelled'
    ) AS cancelled_orders
);


